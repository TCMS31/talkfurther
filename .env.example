# Copy to `.env` and fill in. Never commit the real file.

# Required. The only credential this project needs.
OPENAI_API_KEY=sk-your-key-here

# Models. The guard model runs classification and verification — high volume,
# narrow tasks — so it is deliberately the cheaper tier.
AGENT_MODEL=gpt-4o
GUARD_MODEL=gpt-4o-mini

# Guardrail toggles. The deterministic layers cannot be disabled by design;
# these switch only the LLM-backed stages, so their cost can be measured.
ENABLE_CRISIS_CLASSIFIER=true
ENABLE_GROUNDING_VERIFIER=true
MAX_REPAIR_ATTEMPTS=1

# Facility clock. Injected at runtime rather than pinned in the prompt.
FACILITY_TIMEZONE=America/New_York

# Pin the clock for reproducible evals. Unset in normal use.
# FROZEN_NOW=2025-03-04T05:40:00

# Run against a scripted double — no key, no cost. Deterministic layers are
# genuinely exercised; response quality is NOT meaningful in this mode.
# OFFLINE_MODE=1

REQUEST_TIMEOUT_S=30

# On-disk sinks. Both default to the repo root, which is not writable in the
# container image, so both are overridden there.
TRACE_PATH=traces.jsonl
CAPTURE_PATH=captured_records.jsonl
