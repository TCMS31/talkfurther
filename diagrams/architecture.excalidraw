    {
      "id": "notet",
      "type": "text",
      "x": 75,
      "y": 1668,
      "width": 470,
      "height": 294,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
